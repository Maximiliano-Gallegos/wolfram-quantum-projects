Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "AnalisisEscalamientoLocalidad", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"AnalisisEscalamientoLocalidad", "[", 
   RowBox[{"constructorCircuito_", ",", "tamanos_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "resultados", ",", "n", ",", "params", ",", "lista", ",", "k", ",", 
      "datos", ",", "qubitsCono", ",", "tamano", ",", "fraccion", ",", 
      "radio", ",", "gates", ",", "capas", ",", "profundidad"}], "}"}], ",", 
    RowBox[{
     RowBox[{"resultados", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"(*", 
        RowBox[{"Par\[AAcute]metros", " ", "simb\[OAcute]licos"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"params", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Array", "[", 
             RowBox[{"\[Theta]", ",", "n"}], "]"}], ",", 
            RowBox[{"Array", "[", 
             RowBox[{"\[Phi]", ",", "n"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Construir", " ", "circuito"}], "*)"}], 
         RowBox[{"lista", "=", 
          RowBox[{"constructorCircuito", "[", 
           RowBox[{"n", ",", "params"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Observable", " ", "central"}], "*)"}], 
         RowBox[{"k", "=", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Cono", " ", "causal"}], "*)"}], 
         RowBox[{"datos", "=", 
          RowBox[{"ConoCausal", "[", 
           RowBox[{"lista", ",", 
            RowBox[{"{", "k", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"qubitsCono", "=", 
          RowBox[{"datos", "[", "\"\<Qubits\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"gates", "=", 
          RowBox[{"datos", "[", "\"\<GateIndices\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tamano", "=", 
          RowBox[{"Length", "[", "qubitsCono", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fraccion", "=", 
          RowBox[{"N", "[", 
           RowBox[{"tamano", "/", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"radio", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"qubitsCono", "-", "k"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"capas", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"lista", "[", 
              RowBox[{"[", "gates", "]"}], "]"}], ",", "\"\<Layer\>\""}], 
            "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"profundidad", "=", 
          RowBox[{"Length", "[", "capas", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
           RowBox[{"\"\<Observable\>\"", "->", 
            RowBox[{"\"\<q\>\"", "<>", 
             RowBox[{"ToString", "[", "k", "]"}]}]}], ",", 
           RowBox[{"\"\<Qubits cono\>\"", "->", "qubitsCono"}], ",", 
           RowBox[{"\"\<|LC|\>\"", "->", "tamano"}], ",", 
           RowBox[{"\"\<|LC|/n\>\"", "->", "fraccion"}], ",", 
           RowBox[{"\"\<Radio\>\"", "->", "radio"}], ",", 
           RowBox[{"\"\<Profundidad efectiva\>\"", "->", "profundidad"}]}], 
          "|>"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "tamanos"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Dataset", "[", "resultados", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"AnalisisEscalamientoLocalidad", "[", 
  RowBox[{"ListaLocal", ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "6", ",", "8", ",", "10", ",", "12"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
