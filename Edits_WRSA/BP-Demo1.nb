Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"averageWeight", ",", "averageTheta", ",", "averagePhi"}], "}"}], 
   "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "th", ",", "ph", ",", "average", ",", "w", ",", "wt", ",", "wp"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"average", "[", "e_", "]"}], ":=", 
       RowBox[{
        RowBox[{"average", "[", "e", "]"}], "=", 
        FractionBox[
         RowBox[{"Integrate", "[", 
          RowBox[{"e", ",", 
           RowBox[{"{", 
            RowBox[{"th", ",", 
             RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ph", ",", 
             RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
           RowBox[{"GenerateConditions", "\[Rule]", "False"}]}], "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]"}], ")"}], "2"]]}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", ",", "wt", ",", "wp"}], "}"}], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", 
            RowBox[{
             SubscriptBox["\[PartialD]", "th"], "#1"}], ",", 
            RowBox[{
             SubscriptBox["\[PartialD]", "ph"], "#1"}]}], "}"}], "&"}], ")"}],
         "[", 
        RowBox[{"siteWeight", "[", 
         RowBox[{"th", ",", "ph"}], "]"}], "]"}]}], ";", 
      RowBox[{"Map", "[", 
       RowBox[{"average", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "##1"}], "]"}], "]"}], "&"}], ")"}], "@@@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"w", ",", "w", ",", "w", ",", "w"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", "w", ",", "wt", ",", "wt"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", "w", ",", "wp", ",", "wp"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9985805648153343`*^9, 3.9985806061507454`*^9}, {
