Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ansatz", "[", 
    RowBox[{"thetas_List", ",", "phis_List"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", "thetas", "]"}], "===", 
    RowBox[{"Length", "[", "phis", "]"}]}]}], ":=", 
  RowBox[{"QuantumCircuitOperator", "@", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sites", "=", 
       RowBox[{"Range", "@", 
        RowBox[{"Length", "@", "thetas"}]}]}], "}"}], ",", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"\"\<RY\>\"", "/@", "thetas"}], "->", "sites"}], "]"}], ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"\"\<CZ\>\"", "->", 
         RowBox[{"Partition", "[", 
          RowBox[{"sites", ",", "2", ",", "1"}], "]"}]}], "]"}], ",", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"\"\<RY\>\"", "/@", "phis"}], "->", "sites"}], "]"}]}], 
      "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9985805648153343`*^9, 3.998580578680113*^9}, 
   3.998654033088032*^9},
 CellLabel->
