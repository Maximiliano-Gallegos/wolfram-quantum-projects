Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"bond", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"transferAmplitude", "[", 
      RowBox[{"thetas_List", ",", "phis_List"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"Length", "[", "thetas", "]"}], "===", 
      RowBox[{"Length", "[", "phis", "]"}]}]}], ":=", 
    RowBox[{"Expand", "@", 
     RowBox[{"Total", "@", 
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#1", ".", "bond"}], ")"}], " ", "#2"}], "&"}], ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{"siteWeight", ",", 
          RowBox[{"{", 
           RowBox[{"thetas", ",", "phis"}], "}"}]}], "]"}]}], 
       "]"}]}]}]}]}]}]], "Input",
