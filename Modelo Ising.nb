Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "\[Psi]0", ",", "H", ",", "HH", ",", "\[Psi]1", ",", "G", ",", "\[Phi]", ",",
    "CC", ",", "Ansatz", ",", "Ansatz0", ",", "Ansatz1"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]", "[", "n_", "]"}], ":=", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"StringRepeat", "[", 
    RowBox[{"\"\<0\>\"", ",", "n"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rotaciones", "[", "\[CapitalTheta]_List", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"\[CapitalTheta]", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", "-", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", "\[CapitalTheta]", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CZcapa", "[", "n_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<CZ\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"j", "-", "1"}], ",", "j"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ansatz1", "[", 
   RowBox[{"n_", ",", "parametros_List"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "=", 
       RowBox[{"Take", "[", 
        RowBox[{"parametros", ",", "n"}], "]"}]}], ",", 
      RowBox[{"\[CurlyPhi]", "=", 
       RowBox[{"Take", "[", 
        RowBox[{"parametros", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "1"}], ",", 
           RowBox[{"2", " ", "n"}]}], "}"}]}], "]"}]}]}], "}"}], ",", 
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Rotaciones", "[", "\[Theta]", "]"}], ",", 
       RowBox[{"CZcapa", "[", "n", "]"}], ",", 
       RowBox[{"Rotaciones", "[", "\[CurlyPhi]", "]"}]}], "]"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]1", "[", 
    RowBox[{"n_", ",", "parametros_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Ansatz1", "[", 
     RowBox[{"n", ",", "parametros"}], "]"}], "[", 
    RowBox[{"\[Phi]", "[", "n", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"id2", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xMat", "=", 
   RowBox[{"PauliMatrix", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zMat", "=", 
    RowBox[{"PauliMatrix", "[", "3", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KronLista", "[", "lista_List", "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{"KroneckerProduct", ",", 
     RowBox[{"First", "[", "lista", "]"}], ",", 
     RowBox[{"Rest", "[", "lista", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OperadorLocal", "[", 
     RowBox[{
      RowBox[{"op_", "?", "MatrixQ"}], ",", "n_Integer", ",", "j_Integer"}], 
     "]"}], "/;", 
    RowBox[{"1", "<=", "j", "<=", "n"}]}], ":=", 
   RowBox[{"KronLista", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"k", "==", "j"}], ",", "op", ",", "id2"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HIsingMatriz", "[", 
     RowBox[{"n_Integer", ",", "J_", ",", "h_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "J"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"OperadorLocal", "[", 
           RowBox[{"zMat", ",", "n", ",", "j"}], "]"}], ".", 
          RowBox[{"OperadorLocal", "[", 
           RowBox[{"zMat", ",", "n", ",", 
            RowBox[{"j", "+", "1"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "-", 
      RowBox[{"h", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"OperadorLocal", "[", 
          RowBox[{"zMat", ",", "n", ",", "j"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HIsing", "[", 
    RowBox[{"n_Integer", ",", "J_", ",", "h_"}], "]"}], ":=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"HIsingMatriz", "[", 
     RowBox[{"n", ",", "J", ",", "h"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CostoIsing", "[", 
    RowBox[{"n_Integer", ",", "parametros_List", ",", "J_", ",", "h_"}], 
    "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SuperDagger", "[", 
         RowBox[{"\[Psi]1", "[", 
          RowBox[{"n", ",", "parametros"}], "]"}], "]"}], "[", 
        RowBox[{
         RowBox[{"HIsing", "[", 
          RowBox[{"n", ",", "J", ",", "h"}], "]"}], "[", 
         RowBox[{"\[Psi]1", "[", 
          RowBox[{"n", ",", "parametros"}], "]"}], "]"}], "]"}], ")"}], 
      "[", "\"\<Scalar\>\"", "]"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"parametros", ",", 
          RowBox[{"{", 
           RowBox[{"J", ",", "h"}], "}"}]}], "]"}], ",", "Reals"}], "]"}]}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Gradiente", "[", 
   RowBox[{"n_", ",", "parametros_", ",", "J_", ",", "h_", ",", "k_"}], "]"}],
   ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"CostoIsing", "[", 
       RowBox[{"n", ",", "parametros", ",", "J", ",", "h"}], "]"}], ",", 
      RowBox[{"parametros", "[", 
       RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"parametros", ",", 
         RowBox[{"{", 
          RowBox[{"J", ",", "h"}], "}"}]}], "]"}], ",", "Reals"}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"params2", "=", 
   RowBox[{"{", 
    RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Phi]1", ",", "\[Phi]2"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"params3", "=", 
   RowBox[{"{", 
    RowBox[{
    "\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3", ",", "\[Phi]1", ",", 
     "\[Phi]2", ",", "\[Phi]3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"grad3", "=", 
   RowBox[{"Gradiente", "[", 
    RowBox[{"3", ",", "params3", ",", "J", ",", "h", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MeanGrad3", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}], "^", "6"}]}], ")"}], 
     RowBox[{"Integrate", "[", 
      RowBox[{"grad3", ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]1", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]2", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]3", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]1", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]2", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]3", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"terminos", "=", 
    RowBox[{"List", "@@", 
     RowBox[{"Expand", "[", 
      RowBox[{"grad3", "^", "2"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"promedio", "=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]1", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]2", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]3", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]1", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]2", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]3", ",", 
           RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}]}], "]"}], "&"}], "/@", 
      "terminos"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SegundoMomento3", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"promedio", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi"}], ")"}], "^", "6"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VarGrad3", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"SegundoMomento3", "-", 
     RowBox[{"MeanGrad3", "^", "2"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
